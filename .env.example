# Optional environment variable names only; never put real values in this file.
# The starter reads process.env directly and does not automatically load .env files.

# Set only after explicit Reddit API approval and OAuth setup.
REDDIT_ACCESS_TOKEN=

# A separately stored 32-byte key represented by 64 hexadecimal characters.
# Required only when using the encrypted vault outside this repository.
AXIOM_VAULT_KEY=
